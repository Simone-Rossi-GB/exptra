# ExpenseTracker - Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# OAuth Credentials (DO NOT commit the real values!)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_CLIENT_SECRET=your_google_client_secret_here

VITE_GITHUB_CLIENT_ID=your_github_client_id_here
VITE_GITHUB_CLIENT_SECRET=your_github_client_secret_here

# PocketBase URL
VITE_POCKETBASE_URL=https://yourdomain.no-ip.org

# App Configuration
VITE_APP_NAME=ExpenseTracker
VITE_APP_VERSION=0.1.0

# Note: Only variables prefixed with VITE_ are exposed to the frontend
# Never commit .env.local to version control!
